<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:label="@string/login"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".auth.SignUpActivity"
            android:exported="false"
            android:label="@string/sign_up"
            android:parentActivityName=".auth.LoginActivity" />

        <activity
            android:name=".auth.ChangePasswordActivity"
            android:exported="false"
            android:label="@string/change_password_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.upload.UploadVideoActivity"
            android:exported="false"
            android:label="Upload Video"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.upload.UploadPodcastActivity"
            android:exported="false"
            android:label="Upload Podcast"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.blog.CreatePostActivity"
            android:exported="false"
            android:label="Create Post"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.PlaylistActivity"
            android:exported="false"
            android:label="@string/my_playlists"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.HistoryActivity"
            android:exported="false"
            android:label="@string/history"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.LikesActivity"
            android:exported="false"
            android:label="@string/liked_videos"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.DownloadsActivity"
            android:exported="false"
            android:label="@string/downloads"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/search_hint"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:label="@string/title_notifications"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".ui.notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>