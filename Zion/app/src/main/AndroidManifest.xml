<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zion">
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.profile.MyUploadsTabbedActivity"
            android:exported="false"
            android:label="@string/my_uploads"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.LikesActivity"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.profile.HistoryActivity"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.profile.DownloadsActivity"
            android:parentActivityName=".MainActivity" />


        <activity
            android:name=".ui.profile.FollowingActivity"
            android:exported="false"
            android:label="@string/following"
            android:parentActivityName=".MainActivity" />

        <!-- NEW: My Blogs Activity -->
        <activity
            android:name=".ui.profile.MyBlogsActivity"
            android:exported="false"
            android:label="@string/my_blogs"
            android:parentActivityName=".MainActivity" />

        <!-- NEW: Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <!-- NEW: Search Activity -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/search_hint"
            android:parentActivityName=".MainActivity" />

        <!-- NEW: Notifications Activity -->
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:label="@string/title_notifications"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>