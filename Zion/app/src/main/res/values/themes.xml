<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/surface_light</item>
        <item name="colorOnPrimary">@color/on_surface_light</item> <item name="colorPrimaryContainer">@color/secondary_light</item> <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_light</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorOnBackground">@color/on_surface_light</item>

        <item name="colorSurfaceVariant">@color/secondary_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_light</item>
        <item name="colorSurfaceContainer">@color/secondary_light</item>
        <item name="colorSurfaceContainerHigh">@color/secondary_light</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>


        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Assist</item>


        <item name="tabSelectedTextColor">?attr/colorPrimary</item> <!-- Optional: Match indicator color for selected text -->
        <item name="tabIndicatorColor">?attr/colorPrimary</item> <!-- Ensures indicator uses primary -->
    </style>
</resources>