<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <!-- This color is from your themes.xml -->
            <solid android:color="?attr/colorOnSurfaceVariant" />
            <size
                android:width="6dp"
                android:height="6dp" />
        </shape>
    </item>
</layer-list>
