<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    tools:context=".ui.profile.EditProfileActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:stateListAnimator="@null">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_banner"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
                android:background="?attr/colorSurfaceVariant"
                tools:src="@tools:sample/backgrounds/scenic" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#33000000"
                app:layout_constraintTop_toTopOf="@id/image_banner"
                app:layout_constraintBottom_toBottomOf="@id/image_banner"
                app:layout_constraintStart_toStartOf="@id/image_banner"
                app:layout_constraintEnd_toEndOf="@id/image_banner"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit_24dp"
                app:tint="?attr/colorOnPrimary"
                app:layout_constraintTop_toTopOf="@id/image_banner"
                app:layout_constraintBottom_toBottomOf="@id/image_banner"
                app:layout_constraintStart_toStartOf="@id/image_banner"
                app:layout_constraintEnd_toEndOf="@id/image_banner"
                android:contentDescription="Edit Banner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRemoveBanner"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remove Banner"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_delete_forever_24dp"
                app:iconTint="?attr/colorError"
                app:layout_constraintTop_toBottomOf="@id/image_banner"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                tools:visibility="visible"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/image_profile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:civ_border_color="?attr/colorSecondary"
                app:civ_border_width="2dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/buttonRemoveBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:src="@tools:sample/avatars" />

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_scrim"
                app:layout_constraintTop_toTopOf="@id/image_profile"
                app:layout_constraintBottom_toBottomOf="@id/image_profile"
                app:layout_constraintStart_toStartOf="@id/image_profile"
                app:layout_constraintEnd_toEndOf="@id/image_profile"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit_24dp"
                app:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorSecondary"
                app:layout_constraintTop_toTopOf="@id/image_profile"
                app:layout_constraintBottom_toBottomOf="@id/image_profile"
                app:layout_constraintStart_toStartOf="@id/image_profile"
                app:layout_constraintEnd_toEndOf="@id/image_profile"
                android:contentDescription="Edit Profile Picture" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRemoveImage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remove Picture"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_delete_forever_24dp"
                app:iconTint="?attr/colorError"
                app:layout_constraintTop_toBottomOf="@id/image_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_account_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Account Name"
                app:layout_constraintTop_toBottomOf="@id/buttonRemoveImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Username"
                app:prefixText="\@"
                app:layout_constraintTop_toBottomOf="@id/layout_account_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_bio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Bio"
                app:counterEnabled="true"
                app:counterMaxLength="150"
                app:layout_constraintTop_toBottomOf="@id/layout_username"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLength="150"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_email_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Email"
                app:layout_constraintTop_toBottomOf="@id/layout_bio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Save Changes"
                app:backgroundTint="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/layout_email_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/button_save"
                app:layout_constraintBottom_toBottomOf="@id/button_save"
                app:layout_constraintStart_toStartOf="@id/button_save"
                app:layout_constraintEnd_toEndOf="@id/button_save" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>