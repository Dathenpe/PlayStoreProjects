<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_button_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="56dp" /> <androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_image_start"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_end="112dp"/> <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/poll_option_input_layout"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@id/guideline_image_start" app:layout_constraintBottom_toBottomOf="parent"
    android:layout_marginEnd="8dp"
    app:endIconMode="custom"
    app:endIconDrawable="@drawable/ic_remove_circle_outline_24dp"
    app:endIconContentDescription="Remove Option"
    app:endIconCheckable="false"
    app:endIconTint="?attr/colorError"
    tools:hint="Option 3">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_poll_option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:minHeight="48dp" />

</com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_poll_option_preview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/poll_option_input_layout"
        app:layout_constraintStart_toEndOf="@id/guideline_image_start" app:layout_constraintEnd_toStartOf="@id/guideline_button_start" app:layout_constraintTop_toTopOf="@id/poll_option_input_layout"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
        tools:src="@tools:sample/backgrounds/scenic"
        tools:visibility="visible"/>

    <ImageButton
        android:id="@+id/button_add_poll_option_image"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Add image to option"
        android:src="@drawable/ic_add_photo_alternate_24dp"
        app:tint="?attr/colorSecondary"
        app:layout_constraintBottom_toBottomOf="@id/poll_option_input_layout"
        app:layout_constraintStart_toEndOf="@id/guideline_button_start" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/poll_option_input_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>