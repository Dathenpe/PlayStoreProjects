<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.profile.ProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="64dp">

            <ImageView
                android:id="@+id/channel_banner"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="Profile Banner"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_banner_placeholder" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/image_profile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="16dp"
                app:civ_border_color="@color/black"
                app:civ_border_width="4dp"
                app:layout_constraintBottom_toBottomOf="@id/channel_banner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/channel_banner"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/text_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/image_profile"
                app:layout_constraintStart_toStartOf="@id/image_profile"
                tools:text="Jsmith_zionfan" />

            <TextView
                android:id="@+id/text_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/text_username"
                app:layout_constraintStart_toStartOf="@id/text_username"
                tools:text="\@jsmith"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/text_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/text_handle"
                app:layout_constraintStart_toStartOf="@id/text_username"
                tools:text="john.smith@example.com" />

            <TextView
                android:id="@+id/text_bio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/text_email"
                app:layout_constraintStart_toStartOf="@id/text_username"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="This is my bio. I love Zion. This text can wrap to multiple lines."
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/text_verification_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/text_bio"
                app:layout_constraintStart_toStartOf="@id/text_username"
                tools:text="Email verified ✓"
                tools:visibility="visible"/>

            <LinearLayout
                android:id="@+id/stats_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/text_verification_status"
                app:layout_constraintStart_toStartOf="@id/text_username"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/text_follower_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="142" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/followers"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/text_join_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="• Joined October 2025"
                    tools:visibility="visible"/>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verification_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stats_layout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="?attr/colorError" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/email_not_verified"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resend_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resend_verification"
                        android:textColor="?attr/colorSecondary"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_login_signup_prompt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_sign_up_prompt"
                android:visibility="gone"
                app:icon="@drawable/ic_login_24dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/verification_banner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_playlist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/my_playlists"
                app:icon="@drawable/ic_playlist_play_24dp"
                app:iconTint="?attr/colorSecondary"
                app:iconGravity="textStart"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/button_login_signup_prompt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/separator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="?attr/colorSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/button_playlist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <GridLayout
                android:id="@+id/grid_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                app:layout_constraintTop_toBottomOf="@id/separator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_uploads"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_upload_24dp" android:contentDescription="@string/my_uploads"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:text="@string/my_uploads"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_blogs"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_feed_24dp" android:contentDescription="@string/my_posts"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:text="@string/my_posts"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_likes"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_like" android:contentDescription="@string/liked_videos"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:text="@string/liked_videos"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_history"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_history_24dp" android:contentDescription="@string/history"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:id="@+id/text_history_count" android:text="@string/history"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_downloads"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_download_24dp" android:contentDescription="@string/downloads"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:text="@string/downloads"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_following"
                    style="@style/Widget.App.ProfileCard">
                    <LinearLayout style="@style/Widget.App.ProfileCardContent">
                        <ImageView style="@style/Widget.App.ProfileCardIcon" android:src="@drawable/ic_person_24dp" android:contentDescription="@string/following"/>
                        <TextView style="@style/Widget.App.ProfileCardText" android:text="@string/following"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:gravity="start|center_vertical"
                android:text="@string/settings"
                app:icon="@drawable/ic_dashboard_black_24dp"
                app:iconTint="?attr/colorSecondary"
                android:textColor="?attr/colorOnSurface"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/grid_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>