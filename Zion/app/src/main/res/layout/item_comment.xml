<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comment_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/reply_thread_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/author_avatar"
        app:layout_constraintBottom_toBottomOf="@id/comment_actions"
        app:layout_constraintStart_toStartOf="@id/author_avatar"
        app:layout_constraintEnd_toEndOf="@id/author_avatar"
        tools:visibility="visible" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/author_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/content_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="44dp" />

    <TextView
        android:id="@+id/author_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/content_start_guideline"
        app:layout_constraintTop_toTopOf="@id/author_avatar"
        tools:text="Author Name" />

    <TextView
        android:id="@+id/timestamp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBaseline_toBaselineOf="@id/author_name"
        app:layout_constraintStart_toEndOf="@id/author_name"
        tools:text="• 2h ago" />

    <TextView
        android:id="@+id/comment_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintEnd_toStartOf="@id/button_comment_options"
        app:layout_constraintStart_toStartOf="@id/content_start_guideline"
        app:layout_constraintTop_toBottomOf="@id/author_name"
        tools:text="This is the comment text. It can be multiple lines long and potentially quite lengthy, useful for testing wrapping." />

    <ImageButton
        android:id="@+id/button_comment_options"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:contentDescription="More options"
        app:icon="@drawable/ic_more_vert_24dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/author_name"
        app:layout_constraintBottom_toBottomOf="@id/timestamp_text"/>


    <LinearLayout
        android:id="@+id/comment_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/content_start_guideline"
        app:layout_constraintTop_toBottomOf="@id/comment_text">

        <ImageButton
            android:id="@+id/button_like_comment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_thumb_up_outline_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like Comment"
            app:tint="?attr/colorSecondary" />

        <TextView
            android:id="@+id/like_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="15"
            tools:visibility="visible"/>

        <ImageButton
            android:id="@+id/button_dislike_comment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_thumb_down_outline_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dislike Comment"
            app:tint="?attr/colorSecondary" />

        <TextView
            android:id="@+id/dislike_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" tools:text="2"
            tools:visibility="gone"/>
        <com.google.android.material.button.MaterialButton
        android:id="@+id/button_reply"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Reply"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorSecondary"
        app:icon="@drawable/ic_comment"
        app:iconSize="16dp"
        app:iconPadding="4dp"
        app:iconTint="?attr/colorSecondary"/>

    </LinearLayout>

    <TextView
        android:id="@+id/view_replies_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/selectableItemBackground"
        android:textColor="?attr/colorSecondary"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_subdirectory_arrow_right_24dp"
        app:drawableTint="?attr/colorSecondary"
        android:drawablePadding="4dp"
        app:layout_constraintStart_toStartOf="@id/content_start_guideline"
        app:layout_constraintTop_toBottomOf="@id/comment_actions"
        tools:text="View 2 replies"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>