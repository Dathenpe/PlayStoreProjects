<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode overrides -->
    <style name="Theme.Zion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item> <!-- #FF424242 - Darker gray -->
        <item name="colorOnPrimary">@color/on_primary_dark</item> <!-- White -->
        <item name="colorPrimaryContainer">@color/secondary_dark</item> <!-- Lighter gray -->
        <item name="colorOnPrimaryContainer">@color/black</item> <!-- Black (for contrast if needed) -->

        <item name="colorSecondary">@color/secondary_dark</item> <!-- #FF9E9E9E - Lighter gray -->
        <item name="colorOnSecondary">@color/on_secondary_dark</item> <!-- White (fixed for contrast) -->
        <item name="colorSecondaryContainer">@color/secondary_dark</item> <!-- Lighter gray -->
        <item name="colorOnSecondaryContainer">@color/on_secondary_dark</item> <!-- White -->

        <item name="colorSurface">@color/surface_dark</item> <!-- #FF121212 - Near-black -->
        <item name="colorOnSurface">@color/on_surface_dark</item> <!-- White -->
        <item name="android:colorBackground">@color/surface_dark</item> <!-- Near-black -->
        <item name="colorOnBackground">@color/on_surface_dark</item> <!-- White -->

        <item name="colorSurfaceVariant">@color/secondary_dark</item> <!-- Lighter gray -->
        <item name="colorOnSurfaceVariant">@color/on_surface_dark</item> <!-- White -->
        <item name="colorSurfaceContainer">@color/secondary_dark</item> <!-- Lighter gray -->
        <item name="colorSurfaceContainerHigh">@color/secondary_dark</item> <!-- Lighter gray -->

        <item name="android:statusBarColor">?attr/colorSurface</item> <!-- Near-black -->
        <item name="android:windowLightStatusBar">false</item> <!-- Light icons on dark bar -->

        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Assist</item>

        <!-- Tab indicator - Uses primary (darker gray) -->
        <item name="tabSelectedTextColor">?attr/colorPrimary</item> <!-- Darker gray for selected text -->
        <item name="tabIndicatorColor">?attr/colorPrimary</item> <!-- Darker gray indicator -->

        <!-- Customize TextInputLayout for dark mode contrast -->
        <item name="textInputStyle">@style/Widget.Zion.TextInputLayout.OutlinedBox</item>
        <item name="colorOutline">@color/gray_outline</item> <!-- #FF9E9E9E - High-contrast gray outline -->
    </style>

    <!-- FIXED: Custom TextInputLayout style - Uses color state list for stroke (dark mode) -->
    <style name="Widget.Zion.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">2dp</item> <!-- Thicker for visibility -->
        <item name="boxStrokeWidthFocused">2dp</item> <!-- Same thickness on focus -->
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item> <!-- White hints in dark -->
        <item name="boxStrokeColor">@color/text_input_stroke</item> <!-- State list for focused/unfocused -->
    </style>

</resources>