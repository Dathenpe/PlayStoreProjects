<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurfaceContainerLow"
    android:fitsSystemWindows="true"> <!-- Ensures content doesn't go under system bars -->

    <!-- Material 3 styled text input for journal entry -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/journal_entry_input_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Write your journal entry..."
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:hintEnabled="true"
        app:hintAnimationEnabled="true"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/journal_entry_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:maxLines="10"
            android:scrollbars="vertical" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Material 3 styled button for saving the journal entry -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_journal_entry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Entry"
        android:layout_gravity="end"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:icon="@drawable/outline_add_circle_24"
        app:iconGravity="textStart"
        android:textColor="?attr/colorPrimary"
        app:iconPadding="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:cornerRadius="28dp" /> <!-- M3 prefers larger corner radii -->

</LinearLayout>
