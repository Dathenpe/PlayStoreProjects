<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="funcorner.WordScrambleGameFragment"> <!-- VERIFY: Correct path to your Fragment -->

    <!-- Top Info Card: Score, Timer, Round, Mode Selection -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/info_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/score_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Score: 0"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" /> <!-- VERIFY: Theme attributes exist -->

            <TextView
                android:id="@+id/timer_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time: 00:00"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" /> <!-- VERIFY: Theme attributes exist -->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/round_text_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Round: 1/10"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" /> <!-- VERIFY: Theme attributes exist -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode:"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
            android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/mode_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

    <!-- Game Content Card -->
<com.google.android.material.card.MaterialCardView
android:id="@+id/game_content_card"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_marginHorizontal="16dp"
android:layout_marginTop="16dp"
android:layout_marginBottom="16dp"
app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:layout_constraintTop_toBottomOf="@id/info_card"
    app:layout_constraintBottom_toTopOf="@id/buttons_container"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:gravity="center"
android:padding="24dp">

<!-- Container for individual scrambled letters - now a GridLayout -->
<GridLayout
    android:id="@+id/scrambled_letters_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alignmentMode="alignMargins"
    android:columnOrderPreserved="false"
    android:layout_marginBottom="24dp"
    android:padding="8dp"
    android:background="@drawable/card_background_teal"> <!-- VERIFY: Drawable exists -->
    <!-- Individual letter views will be added here programmatically -->
</GridLayout>

<!-- Modernized Guess Display TextView -->
<TextView
    android:id="@+id/guess_display_text_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingVertical="12dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/rounded_background_lightgray"
android:textAppearance="?attr/textAppearanceHeadlineSmall"
android:textColor="?attr/colorOnSurface"
android:maxLines="1"
android:singleLine="true"
android:text="" />

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit_button"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Guess"
        android:layout_marginEnd="8dp"
        app:iconTint="?attr/colorOnPrimary" /> <!-- VERIFY: Theme attribute exists -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backspace_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:strokeWidth="3dp"
        app:cornerRadius="8dp"
        android:padding="12dp"
        app:icon="@drawable/ic_backspace"
    app:iconGravity="textStart"
    android:backgroundTint="?attr/colorPrimary"
    app:iconTint="@color/status_bar_overlay_dark"
    android:contentDescription="Backspace" />
</LinearLayout>

<com.google.android.material.button.MaterialButton
    android:id="@+id/clue_button"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cornerRadius="8dp"
    android:padding="12dp"
    app:strokeWidth="3dp"
    android:text="(3)"
    app:icon="@drawable/ic_lightbulb_outline"
    android:backgroundTint="?attr/colorPrimary"
app:iconGravity="textStart"
app:iconTint="@color/status_bar_overlay_dark"
android:contentDescription="Get a Clue" />
</LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Buttons Container (now without clue button) -->
<LinearLayout
android:id="@+id/buttons_container"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="center"
android:layout_marginBottom="16dp"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<com.google.android.material.button.MaterialButton
    android:id="@+id/pause_button"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    app:cornerRadius="8dp"
    android:padding="12dp"
    app:strokeWidth="3dp"
    android:backgroundTint="?attr/colorPrimary"
    app:icon="@drawable/ic_pause_white_24dp"
app:iconGravity="textStart"
app:iconTint="@color/status_bar_overlay_dark"
android:contentDescription="Pause/Play Game" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/next_word_button"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    app:cornerRadius="8dp"
    android:padding="12dp"
    app:strokeWidth="3dp"
    app:icon="@drawable/ic_skip_next"
    android:backgroundTint="?attr/colorPrimary"
app:iconGravity="textStart"
app:iconTint="@color/status_bar_overlay_dark"
android:contentDescription="Skip Word" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/reset_button"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    app:cornerRadius="8dp"
    app:strokeWidth="3dp"
    android:padding="12dp"
    app:icon="@drawable/ic_refresh"
app:iconGravity="textStart"
    android:backgroundTint="?attr/colorPrimary"
app:iconTint="@color/status_bar_overlay_dark"
android:contentDescription="Reset Game" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/high_scores_button"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cornerRadius="8dp"
    android:padding="12dp"
    app:strokeWidth="3dp"
    android:text="🏆"
    android:backgroundTint="?attr/colorPrimary"
    app:iconTint="?attr/colorOnSecondaryContainer"
android:contentDescription="Show High Scores" />
</LinearLayout>

    <!-- Overlay for Paused/Game Over states -->
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"  tools:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/paused_card"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/pause_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="PAUSED"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/white" /> <com.google.android.material.button.MaterialButton
                android:id="@+id/button_resume_game"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Resume Game"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_play_arrow_white_24dp"
                app:iconTint="?attr/colorPrimary" /> <com.google.android.material.button.MaterialButton
                android:id="@+id/button_restart_game_paused"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Restart Game"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_refresh"
                app:iconTint="?attr/colorPrimary" /> <com.google.android.material.button.MaterialButton
                android:id="@+id/button_info_game"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Game Info"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_info"
                app:iconTint="?attr/colorPrimary" /> <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_and_quit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save and Quit"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_save"
                app:iconTint="?attr/colorPrimary" /> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/game_over_card"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/game_over_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="GAME OVER!"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnErrorContainer" /> <TextView
                android:id="@+id/summary_score_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Final Score: 0"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnErrorContainer" /> <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/correct_words_summary_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="start"
                            android:text="Correct Words: None"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnErrorContainer" />

                        <TextView
                            android:id="@+id/missed_words_summary_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="Missed Words: None"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnErrorContainer" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_restart_game_over"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restart Game"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="?attr/colorOnSecondaryContainer" /> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
