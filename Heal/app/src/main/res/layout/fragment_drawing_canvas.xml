<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="records.DrawingCanvasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Drawing Tools Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Top Row: Tools and Undo/Redo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/buttonPen"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_pen"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Pen"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/buttonEraser"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_eraser"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Eraser"
                        android:padding="8dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="fitCenter"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <ImageButton
                        android:id="@+id/buttonUndo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="?attr/colorOnSurface"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Undo"
                        android:padding="8dp"/>

                    <ImageButton
                        android:id="@+id/buttonRedo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="?attr/colorOnSurface"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Redo"
                        android:padding="8dp"/>

                </LinearLayout>

                <!-- Brush Size SeekBar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/brushSizeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size: 20"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginEnd="8dp"/>

                    <SeekBar
                        android:id="@+id/brushSizeSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="20"/>
                </LinearLayout>


                <!-- Color Palette -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/colorPalette"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">
                        <!-- Color circles will be added programmatically -->
                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Drawing Canvas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="8dp">

            <records.DrawingView
                android:id="@+id/drawingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearCanvas"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp"
                android:textColor="?attr/colorError"
                app:strokeColor="?attr/colorError"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveDrawing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Artwork"
                android:layout_marginStart="8dp"
                app:cornerRadius="8dp"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>