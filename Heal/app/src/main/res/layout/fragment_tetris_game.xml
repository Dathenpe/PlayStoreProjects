<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#222222"
    tools:context="funcorner.TetrisGameFragment">

    <TextView
        android:id="@+id/game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TETRIS"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:shadowColor="#00BCD4"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/score_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="32dp" />

        <TextView
            android:id="@+id/level_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level: 1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tetris_board_background"
        android:padding="4dp">

        <!-- Custom Tetris View for drawing the game -->
        <tetris.TetrisView
            android:id="@+id/tetris_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#000000" />
    </FrameLayout>

    <TextView
        android:id="@+id/game_over_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAME OVER!"
        android:textColor="#FF0000"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:shadowColor="#FF0000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <TextView
        android:id="@+id/pause_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAUSED"
        android:textColor="#00BCD4"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:shadowColor="#00BCD4"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/button_rotate"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_rotate_right_white_24dp"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Rotate"
                android:layout_marginEnd="20dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/button_pause_play"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_pause_white_24dp"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Pause/Play"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal">

            <ImageButton
                android:id="@+id/button_left"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_arrow_left_white_24dp"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Move Left"
                android:layout_marginEnd="10dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/button_down"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_arrow_down_white_24dp"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Move Down"
                android:layout_marginEnd="10dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/button_right"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_arrow_right_white_24dp"
                android:background="@drawable/button_background"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="Move Right"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>