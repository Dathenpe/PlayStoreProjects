<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_chat_coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RecyclerView is drawn first, so it's at the "bottom" of the Z-order -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="64dp"
    android:paddingBottom="76dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:listitem="@layout/item_ai_message" />

    <!-- Icons and FABs are drawn after RecyclerView, so they appear on top -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_clear_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/clear_ai_history"
        app:tint="@color/black"
        app:backgroundTint="?attr/colorPrimary"
        app:rippleColor="?attr/colorError"
        android:src="@android:drawable/ic_menu_delete"/>

    <ImageView
        android:id="@+id/network_status_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_network_connected"
        android:contentDescription="Network status icon"
        app:tint="?attr/colorOnSurfaceVariant"/> <!-- Removed duplicate android:tint -->

    <!-- Input container at the bottom, drawn last among these main elements -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:elevation="6dp"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/message_text_input_layout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message_input_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type your message..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="50dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:background="@drawable/pill_shaped_background" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            app:icon="@drawable/ic_send"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="25dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
