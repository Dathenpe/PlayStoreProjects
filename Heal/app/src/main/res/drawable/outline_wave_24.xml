<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Left Arcs -->
    <!-- Inner Arc (approximates the smaller wave band) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M2,9 A5,5 0 0,1 7,14" />
    <!-- Start (2,9), End (7,14), Radius X=5, Radius Y=5, Small Arc, Clockwise -->

    <!-- Outer Arc (approximates the larger wave band) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M2,6 A8,8 0 0,1 10,14" />
    <!-- Start (2,6), End (10,14), Radius X=8, Radius Y=8, Small Arc, Clockwise -->

    <!-- Right Arcs -->
    <!-- Inner Arc -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M22,9 A5,5 0 0,0 17,14" />
    <!-- Start (22,9), End (17,14), Radius X=5, Radius Y=5, Small Arc, Counter-Clockwise -->

    <!-- Outer Arc -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M22,6 A8,8 0 0,0 14,14" />
    <!-- Start (22,6), End (14,14), Radius X=8, Radius Y=8, Small Arc, Counter-Clockwise -->

    <!-- Center dot (left side) - kept filled -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7,12c0.55,0 1,-0.45 1,-1s-0.45,-1 -1,-1s-1,0.45 -1,1S6.45,12 7,12z"/>
    <!-- This is a 2dp diameter circle centered at (7,11) -->

    <!-- Center dot (right side) - kept filled -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M17,10c0.55,0 1,-0.45 1,-1s-0.45,-1 -1,-1s-1,0.45 -1,1S16.45,10 17,10z"/>
    <!-- This is a 2dp diameter circle centered at (17,9) -->

</vector>
