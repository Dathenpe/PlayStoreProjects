<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Kite Body Outline -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:pathData="M12,1.5
                         L4,10
                         L12,20
                         L20,10
                         L12,1.5z" />

    <!-- Vertical Spar -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1"
        android:pathData="M12,1.5 L12,20" />

    <!-- Horizontal Spar (slightly curved for a bit of realism/style) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1"
        android:pathData="M4,10 Q12,9 20,10" />

    <!-- Kite Tail -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12,20
                         Q11,21.5 12.5,22.5
                         Q14,23.5 12,23.5" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12.5,22.5
                         C11.5,24 13.5,25 12.5,26" />
    <!-- Small tail bows/ties (optional, can be complex for a small icon) -->
    <!-- You could add small circles or diamond shapes along the tail path if desired -->

</vector>
