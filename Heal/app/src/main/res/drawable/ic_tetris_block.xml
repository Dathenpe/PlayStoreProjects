<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- This vector drawable contains both an 'L' shaped Tetris block (rotated) and a 'T' shaped Tetris block.
         Each individual square block is 4x4dp to fit both shapes within the 24x24dp viewport. -->

    <!-- L-Block (Orange, rotated 90 degrees clockwise) -->
    <!-- Shape:
         . . X .
         . . X .
         . . X X
         (where X is a 4x4dp block) -->
    <path
        android:fillColor="#FFA500"
        android:pathData="M16,0h4v4h-4z" /> <!-- Top block (x=16, y=0) -->
    <path
        android:fillColor="#FFA500"
        android:pathData="M16,4h4v4h-4z" /> <!-- Middle block (x=16, y=4) -->
    <path
        android:fillColor="#FFA500"
        android:pathData="M16,8h4v4h-4z" /> <!-- Bottom vertical block (x=16, y=8) -->
    <path
        android:fillColor="#FFA500"
        android:pathData="M20,8h4v4h-4z" /> <!-- Bottom horizontal "foot" block (x=20, y=8) -->


    <!-- T-Block (Magenta) -->
    <!-- Shape:
         . X .
         X X X
         (where X is a 4x4dp block) -->
    <path
        android:fillColor="#FF00FF"
        android:pathData="M4,14h4v4h-4z" /> <!-- Top middle block (x=4, y=14) -->
    <path
        android:fillColor="#FF00FF"
        android:pathData="M0,18h4v4h-4z" /> <!-- Bottom left block (x=0, y=18) -->
    <path
        android:fillColor="#FF00FF"
        android:pathData="M4,18h4v4h-4z" /> <!-- Bottom middle block (x=4, y=18) -->
    <path
        android:fillColor="#FF00FF"
        android:pathData="M8,18h4v4h-4z" /> <!-- Bottom right block (x=8, y=18) -->

</vector>
