<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/recordFragment"
        android:name="ui.RecordFragment"
        android:label="Records"
        tools:layout="@layout/fragment_record">
        <action
            android:id="@+id/action_recordFragment_to_copingExercisesFragment"
            app:destination="@id/copingExercisesFragment" />
        <action
            android:id="@+id/action_recordFragment_to_moodCheckinFragment"
            app:destination="@id/moodCheckinFragment" />
        <action
            android:id="@+id/action_recordFragment_to_savedStrategiesFragment"
            app:destination="@id/savedStrategiesFragment" />
        <action
            android:id="@+id/action_recordFragment_to_journalEntriesFragment"
            app:destination="@id/journalEntriesFragment" />
        <action
            android:id="@+id/action_recordFragment_to_emergencyContactsFragment"
            app:destination="@id/emergencyContactsFragment" />
    </fragment>

    <fragment
        android:id="@+id/emergencyContactsFragment"
        android:name="records.EmergencyContactsFragment"
        android:label="Emergency Contacts"
        tools:layout="@layout/fragment_emergency_contacts" >
        <action
            android:id="@+id/action_emergencyContactsFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
    </fragment>

    <fragment
        android:id="@+id/copingExercisesFragment"
        android:name="records.CopingExercisesFragment"
        android:label="Coping Exercises"
        tools:layout="@layout/fragment_coping_exercises" >
        <action
            android:id="@+id/action_copingExercisesFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
    </fragment>

    <fragment
        android:id="@+id/moodCheckinFragment"
        android:name="records.MoodCheckinFragment"
        android:label="Mood Checkin"
        tools:layout="@layout/fragment_mood_checkin" >
        <action
            android:id="@+id/action_moodCheckinFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
    </fragment>

    <fragment
        android:id="@+id/savedStrategiesFragment"
        android:name="records.SavedStrategiesFragment"
        android:label="Saved Strategies"
        tools:layout="@layout/fragment_saved_strategies" >
        <action
            android:id="@+id/action_savedStrategiesFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
    </fragment>

    <fragment
        android:id="@+id/journalEntriesFragment"
        android:name="records.JournalEntriesFragment"
        android:label="Journal Entries"
        tools:layout="@layout/fragment_journal_entries" >
        <action
            android:id="@+id/action_journalEntriesFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="ui.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_recordFragment"
            app:destination="@id/recordFragment" />
        <action
            android:id="@+id/action_homeFragment_to_funCornerFragment"
            app:destination="@id/funCornerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_AIFragment"
            app:destination="@id/AIFragment" />
    </fragment>
    <fragment
        android:id="@+id/funCornerFragment"
        android:name="ui.FunCornerFragment"
        android:label="fragment_fun_corner"
        tools:layout="@layout/fragment_fun_corner" >
        <action
            android:id="@+id/action_funCornerFragment_to_artCornerFragment"
            app:destination="@id/artCornerFragment" />
        <action
            android:id="@+id/action_funCornerFragment_to_wordScrambleGameFragment"
            app:destination="@id/wordScrambleGameFragment" />
        <action
            android:id="@+id/action_funCornerFragment_to_memoryMatchGameFragment"
            app:destination="@id/memoryMatchGameFragment" />
        <action
            android:id="@+id/action_funCornerFragment_to_tetrisGameFragment"
            app:destination="@id/tetrisGameFragment" />
    </fragment>
    <fragment
        android:id="@+id/tetrisGameFragment"
        android:name="funcorner.TetrisGameFragment"
        android:label="fragment_tetris_game"
        tools:layout="@layout/fragment_tetris_game" >
        <action
            android:id="@+id/action_tetrisGameFragment_to_funCornerFragment"
            app:destination="@id/funCornerFragment" />
    </fragment>
    <fragment
        android:id="@+id/artCornerFragment"
        android:name="funcorner.PaintFragment"
        android:label="ArtCornerFragment" >
        <action
            android:id="@+id/action_artCornerFragment_to_funCornerFragment"
            app:destination="@id/funCornerFragment" />
    </fragment>
    <fragment
        android:id="@+id/memoryMatchGameFragment"
        android:name="funcorner.MemoryMatchGameFragment"
        android:label="fragment_memory_match_game"
        tools:layout="@layout/fragment_memory_match_game" >
        <action
            android:id="@+id/action_memoryMatchGameFragment_to_funCornerFragment"
            app:destination="@id/funCornerFragment" />
    </fragment>
    <fragment
        android:id="@+id/wordScrambleGameFragment"
        android:name="funcorner.WordScrambleGameFragment"
        android:label="fragment_word_scramble_game"
        tools:layout="@layout/fragment_word_scramble_game" >
        <action
            android:id="@+id/action_wordScrambleGameFragment_to_funCornerFragment"
            app:destination="@id/funCornerFragment" />
    </fragment>
    <navigation android:id="@+id/navigation"
        app:startDestination="@id/mainActivity2">
        <activity
            android:id="@+id/mainActivity2"
            android:name="com.f9ld3.heal.MainActivity"
            android:label="MainActivity" />
    </navigation>
    <fragment
        android:id="@+id/AIFragment"
        android:name="ui.AIFragment"
        android:label="AIFragment" />

</navigation>