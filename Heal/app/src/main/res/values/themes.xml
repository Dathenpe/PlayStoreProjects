<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Heal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet.Modal</item>
        <item name="navigationViewStyle">@style/Widget.Material3.NavigationView</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>

    </style>

    <!-- Define additional themes for different primary colors -->
    <style name="Theme.Heal.Secondary" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/md_theme_secondary</item>
        <item name="colorPrimaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
    </style>

    <style name="Theme.Heal.Tertiary" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/md_theme_tertiary</item>
        <item name="colorPrimaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
    </style>

    <style name="Theme.Heal.Blue" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryContainer">@color/holo_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorPrimaryInverse">@color/blue</item>
    </style>

    <style name="Theme.Heal.Green" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryContainer">@color/lime</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorPrimaryInverse">@color/green</item>
    </style>

    <style name="Theme.Heal.Purple" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryContainer">@color/violet</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorPrimaryInverse">@color/purple</item>
    </style>

    <style name="Theme.Heal.Orange" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryContainer">@color/gold_transparent</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorPrimaryInverse">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Heal.Teal" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryContainer">@color/teal_200</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorPrimaryInverse">@color/teal</item>
    </style>

    <style name="Theme.Heal.Brown" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/brown</item>
        <item name="colorPrimaryContainer">@color/tan</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorPrimaryInverse">@color/brown</item>
    </style>

    <style name="Theme.Heal.Pink" parent="Base.Theme.Heal">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorPrimaryContainer">@color/pink</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorPrimaryInverse">@color/pink_200</item>
    </style>

    <style name="TransparentDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="Theme.Heal" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Default theme properties, can be overridden by specific themes -->
    </style>

    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="labelStyle">@style/Widget.App.Tooltip</item>
        <!-- You can add other slider-specific customizations here if needed -->
    </style>

    <style name="Widget.App.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="android:textColor">@android:color/white</item>
        <!-- You can also customize the background of the tooltip/bubble if needed: -->
         <item name="backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="Theme.Heal.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.Heal.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!-- Headline Medium -->
    <style name="TextAppearance.Material3.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_regular</item> <!-- Assuming 'inter_regular' font is available -->
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.00</item>
        <item name="android:lineHeight">36sp</item>
    </style>

    <!-- Title Large -->
    <style name="TextAppearance.Material3.TitleLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.00</item>
        <item name="android:lineHeight">28sp</item>
    </style>

    <!-- Title Medium -->
    <style name="TextAppearance.Material3.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/inter_medium</item> <!-- Often medium weight for titles -->
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <!-- Body Large -->
    <style name="TextAppearance.Material3.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <!-- Body Medium -->
    <style name="TextAppearance.Material3.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineHeight">20sp</item>
    </style>

    <!-- Body Small -->
    <style name="TextAppearance.Material3.BodySmall" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineHeight">16sp</item>
    </style>

    <!-- Label Small -->
    <style name="TextAppearance.Material3.LabelSmall" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:lineHeight">16sp</item>
    </style>

    <!-- Button -->
    <style name="TextAppearance.Material3.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    <style name="ShapeAppearance.ExpressiveCard.AllRound" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- A style for cards with a large rounded corner on the top-left and bottom-right, and medium rounded corners on the other two. -->
    <style name="ShapeAppearance.ExpressiveCard.TopLeft.BottomRight" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
    </style>

    <!-- A style for cards with a large rounded corner on the bottom-left and top-right, and medium rounded corners on the other two. -->
    <style name="ShapeAppearance.ExpressiveCard.BottomLeft.TopRight" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
